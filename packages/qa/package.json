{
	"name": "@atomicsmash/qa",
	"version": "0.1.0",
	"type": "module",
	"description": "Declarative user-journey QA tests on top of Playwright, configured from smash.config.ts and built for self-healing.",
	"keywords": [
		"playwright",
		"qa",
		"e2e",
		"testing"
	],
	"homepage": "https://www.atomicsmash.co.uk/",
	"license": "GPL-3.0-or-later",
	"author": {
		"name": "Atomic Smash",
		"email": "npm@atomicsmash.co.uk",
		"url": "https://www.atomicsmash.co.uk/"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/AtomicSmash/packages",
		"directory": "packages/qa"
	},
	"files": [
		"./dist/**/*",
		"./templates/**/*"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./runtime": "./dist/runtime/index.js",
		"./playwright-config": "./dist/runtime/playwrightConfig.js",
		"./reporter": "./dist/runtime/reporter.js",
		"./package.json": "./package.json"
	},
	"bin": {
		"smash-qa": "./dist/cli.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "tsc --build --watch tsconfig.build.json",
		"build": "npm-run-all clean compile",
		"clean": "del-cli ./dist/ *.tsbuildinfo",
		"compile": "tsc --build tsconfig.build.json",
		"test": "TZ=\"Europe/Istanbul\" vitest run",
		"test:ui": "TZ=\"Europe/Istanbul\" vitest --ui",
		"test:coverage": "TZ=\"Europe/Istanbul\" vitest run --coverage",
		"lint": "run-p lint:*",
		"lint:eslint": "eslint --cache --cache-location ./node_modules/.cache/eslint . --ext .js,.ts,.jsx,.tsx",
		"lint:types": "tsc -b"
	},
	"peerDependencies": {
		"@playwright/test": "^1.64.1"
	},
	"dependencies": {
		"@atomicsmash/smash-config": "^2.0.3",
		"@atomicsmash/test-utils": "^6.0.4",
		"dotenv": "^17.4.2",
		"yargs": "^18.2.0"
	},
	"devDependencies": {
		"@types/yargs": "^17.0.35"
	}
}
