{
	"extends": "../../tsconfig.base.json",
	"include": ["./src/**/*"],
	"exclude": ["**/dist/**", "**/node_modules/**"],
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",
		"jsx": "react-jsx",
		"paths": {
			"@atomicsmash/blocks-helpers": ["./src/index"]
		},
		"types": [
			"node",
			"@types/wordpress__block-editor",
			"@types/wordpress__blocks"
		]
	}
}
